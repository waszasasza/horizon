{%- doc -%}
  _mmw-assurance — pojedyncza pozycja w mmw-product-assurances (ikona motywu lub własny
  obraz + tekst, w jednej linii). Prywatny sub-blok, dodawany tylko wewnątrz
  mmw-product-assurances.
{%- enddoc -%}
<div class="mmw-assurances__item" {{ block.shopify_attributes }}>
  {% render 'icon-or-image',
    icon: block.settings.icon,
    image_upload: block.settings.image,
    width: 20,
    class_name: 'mmw-assurances__icon'
  %}
  {%- if block.settings.text != blank -%}
    <span class="mmw-assurances__text">{{ block.settings.text }}</span>
  {%- endif -%}
</div>

{% stylesheet %}
  .mmw-assurances__item {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .mmw-assurances__icon {
    flex-shrink: 0;
    color: var(--mmw-01);
  }

  .mmw-assurances__text {
    font-family: var(--mmw-font-label);
    font-weight: 600;
    font-size: 14px;
    line-height: 1.12;
    color: var(--mmw-01);
  }
{% endstylesheet %}

