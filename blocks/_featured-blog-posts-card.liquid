{%- comment -%}
  PLIK NATYWNY HORIZONA, ZMODYFIKOWANY — patrz CLAUDE.md, sekcja "Zmiany w plikach
  natywnych Horizona" (ryzyko nadpisania przy aktualizacji motywu).

  Karta = snippets/mmw-post-card.liquid (współdzielona, docelowo jedyna karta posta
  w motywie — patrz doc-comment tamtego pliku). Oryginalna implementacja (content_for
  bloki _featured-blog-posts-image/_heading/_blog-post-info-text/_blog-post-description)
  zastąpiona jednym render. Te cztery sub-bloki są teraz osierocone w całym motywie —
  NIE usunięte jeszcze, czekają na osobny diff porządkowy.

  Ustawienia tego bloku (alignment/gap/border/padding niżej w schemacie) są od teraz
  NIEUŻYWANE — schemat zostaje bez zmian celowo (osobny diff czyszczący), więc merchant
  może jeszcze widzieć martwe pola w edytorze do czasu tamtej poprawki. Z tego samego
  powodu block.shopify_attributes nie jest już nigdzie wypisywany — zaznaczanie tego
  konkretnego bloku w edytorze (kontur na hover/klik w panelu) może przestać działać
  precyzyjnie do czasu tamtego porządkowania; to świadomy, niższy priorytet niż wygląd.

  sizes liczone z realnej siatki tej sekcji, na dziś skonfigurowanej w templates/index.json:
  layout_type: grid, columns: 3, columns_gap: 24, mobile_columns: 2, section_width:
  page-width → globalny settings.page_width="normal" (120rem/1920px cap, config/
  settings_data.json), page-margin 60px ≥750px / 24px poniżej (assets/base.css).
  Jeśli w edytorze ktoś przełączy layout_type na "carousel" lub "editorial", ta wartość
  przestanie być dokładna (inna matematyka szerokości, patrz mmw-carousel-card dla wzorca
  karuzelowego) — do poprawki, gdyby faktycznie zmieniono tryb.
{%- endcomment -%}
{%- liquid
  assign onboarding = false
  if article == blank or article.title == blank
    assign onboarding = true
  endif
-%}
{%- unless onboarding -%}
  {%- render 'mmw-post-card',
    article: article,
    section_id: section.id,
    sizes: 'auto, (max-width: 749px) calc((100vw - 72px) / 2), calc((min(1920px, 100vw - 120px) - 48px) / 3)'
  -%}
{%- endunless -%}

{% schema %}
{
  "name": "t:names.blog_card",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "t:content.text"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "left",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "right",
          "label": "t:options.right"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "checkbox",
      "id": "inherit_color_scheme",
      "label": "t:settings.inherit_color_scheme",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1",
      "visible_if": "{{ block.settings.inherit_color_scheme == false }}"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.borders",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "solid",
          "label": "t:options.solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 10,
      "step": 0.5,
      "unit": "px",
      "label": "t:settings.border_width",
      "default": 1,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:settings.opacity",
      "default": 100,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
