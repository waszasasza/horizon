{%- doc -%}
  mmw-carousel-card — wspólna karta produktu, współdzielona przez
  sections/mmw-product-carousel.liquid i sections/mmw-product-recommendations.liquid,
  żeby nie utrzymywać dwóch kopii tego samego wyglądu (obraz + hover na drugie
  zdjęcie, automatyczny badge, tytuł, opis, cena, quick-add).

  UWAGA: nazwa celowo NIE "mmw-product-card" — ten plik już istnieje w repo
  (starszy, prostszy komponent, klasy mmw-pcard__*) i jest używany przez
  sections/mmw-article-body.liquid oraz sections/mmw-article-products.liquid,
  obu poza budżetem tego sprintu (CLAUDE.md: "Czego NIE ruszać").

  @param {object} product - produkt do wyrenderowania
  @param {string} section_id - id sekcji wołającej (unikalny link + quick-add form id)
  @param {string} [card_ratio] - aspect-ratio karty (CSS), domyślnie '331 / 507'
  @param {number} [desc_len] - długość skracanego opisu karty, domyślnie 140

  @example
  {% render 'mmw-carousel-card', product: product, section_id: section.id %}
{%- enddoc -%}
{%- liquid
  assign card_ratio = card_ratio | default: '331 / 507'
  assign desc_len = desc_len | default: 140

  assign on_sale = false
  assign badge_text = blank
  assign badge_class = 'mmw-carousel-card__badge'
  if product.compare_at_price > product.price
    assign on_sale = true
    assign discount_pct = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round
    assign badge_text = '-' | append: discount_pct | append: '%'
    assign badge_class = badge_class | append: ' mmw-carousel-card__badge--sale'
  elsif product.tags contains 'bestseller' or product.tags contains 'Bestseller'
    assign badge_text = 'Bestseller'
  elsif product.tags contains 'nowość' or product.tags contains 'nowosc' or product.tags contains 'Nowość'
    assign badge_text = 'Nowość'
  endif
  assign card_text = product.metafields.custom.opis_karty.value | default: product.description
  assign card_text = card_text | strip_html | truncate: desc_len

  # Widoczność quick-add liczona tak samo jak w snippets/product-card.liquid
  assign has_quick_add = false
  if settings.quick_add and product.available
    assign has_quick_add = true
  endif
  assign has_mobile_quick_add = false
  if has_quick_add and settings.mobile_quick_add
    assign has_mobile_quick_add = true
  endif
-%}
<product-card
  class="product-card mmw-carousel-card"
  style="
    --quick-add-display: {% if has_quick_add %}flex{% else %}none{% endif %};
    --quick-add-mobile-display: {% if has_mobile_quick_add %}flex{% else %}none{% endif %};
    --quick-add-mobile-opacity: {% if has_mobile_quick_add %}1{% else %}0{% endif %};
    --mmw-carousel-card-ratio: {{ card_ratio }};
  "
>
  <a href="{{ product.url }}" class="product-card__link" ref="productCardLink" id="mmw-pc-link-{{ section_id }}-{{ product.id }}">
    <span class="visually-hidden">{{ product.title | escape }}</span>
  </a>
  <a class="mmw-carousel-card__media" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
    {%- if product.featured_image != blank -%}
      <img class="mmw-carousel-card__img" loading="lazy" width="640" height="980"
        src="{{ product.featured_image | image_url: width: 640 }}"
        srcset="{{ product.featured_image | image_url: width: 400 }} 400w, {{ product.featured_image | image_url: width: 640 }} 640w, {{ product.featured_image | image_url: width: 900 }} 900w"
        sizes="(max-width: 749px) 60cqw, 400px"
        alt="">
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'mmw-carousel-card__img' }}
    {%- endif -%}
    {%- if product.media.size > 1 -%}
      <img class="mmw-carousel-card__img mmw-carousel-card__img--hover" loading="lazy" width="640" height="980"
        src="{{ product.media[1].preview_image | image_url: width: 640 }}"
        alt="">
    {%- endif -%}
  </a>
  {%- if badge_text != blank -%}<span class="{{ badge_class }}">{{ badge_text }}</span>{%- endif -%}
  <div class="mmw-carousel-card__body">
    <p class="mmw-carousel-card__name">{{ product.title }}</p>
    {%- if card_text != blank -%}<p class="mmw-carousel-card__excerpt">{{ card_text }}</p>{%- endif -%}
    <div class="mmw-carousel-card__price-row">
      <div class="mmw-carousel-card__price-block">
        {%- if on_sale -%}
          <div class="mmw-carousel-card__price-line">
            <span class="mmw-carousel-card__price mmw-carousel-card__price--sale">{{ product.price | money }}</span>
            <span class="mmw-carousel-card__price-compare">{{ product.compare_at_price | money }}</span>
          </div>
          <p class="mmw-carousel-card__price-note">Ostatnia cena przed obniżką: {{ product.compare_at_price | money }}</p>
        {%- else -%}
          <span class="mmw-carousel-card__price">{{ product.price | money }}</span>
        {%- endif -%}
      </div>
      {%- render 'quick-add', product: product, section_id: section_id -%}
    </div>
  </div>
</product-card>

{% stylesheet %}
  .mmw-carousel-card {
    display: block;
    width: 100%;
    aspect-ratio: var(--mmw-carousel-card-ratio, 331 / 507);
    border-radius: 16px;
    overflow: hidden;
    background: var(--mmw-01);
    /* Natywny quick-add liczy prawy-dolny róg z --border-radius/--padding-inline-end/
       --padding-block-end (snippets/quick-add-styles.liquid). Bez nich te zmienne są
       invalid (nikt ich tu nie ustawia poza natywnym systemem spacing-style/product-grid,
       którego nie używamy) i przycisk renderuje się w złym miejscu / poza kadrem. */
    --border-radius: 16px;
    --padding-inline-start: 24px;
    --padding-inline-end: 24px;
    --padding-block-start: 24px;
    --padding-block-end: 24px;
  }

  .mmw-carousel-card__media {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: block;
  }

  .mmw-carousel-card__img,
  .mmw-carousel-card__img svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .mmw-carousel-card__img--hover {
    opacity: 0;
    transition: opacity var(--hover-transition-duration, 0.3s) var(--hover-transition-timing, ease);
  }

  .mmw-carousel-card:hover .mmw-carousel-card__img--hover {
    opacity: 1;
  }

  .mmw-carousel-card::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
    pointer-events: none;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0) 48%, rgba(0, 0, 0, 0.92) 100%);
  }

  .mmw-carousel-card__badge {
    position: absolute;
    top: clamp(12px, 3vw, 24px);
    right: clamp(12px, 3vw, 24px);
    z-index: 2;
    background: var(--mmw-03);
    color: var(--mmw-01);
    font-family: var(--mmw-font-label);
    font-weight: 700;
    font-size: clamp(11px, 2.5vw, 14px);
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: clamp(6px, 1.5vw, 10px) clamp(8px, 2vw, 14px);
    border-radius: 58px;
    line-height: 1.2;
  }

  .mmw-carousel-card__badge--sale {
    background: var(--mmw-02);
  }

  .mmw-carousel-card__body {
    position: absolute;
    z-index: 2;
    left: 24px;
    right: 24px;
    bottom: 24px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .mmw-carousel-card__name {
    margin: 0;
    font-family: var(--mmw-font-display);
    font-weight: 400;
    font-size: 24px;
    line-height: 1;
    color: var(--mmw-04);
  }

  .mmw-carousel-card__excerpt {
    margin: 0;
    font-family: var(--mmw-font-text);
    font-size: 12px;
    line-height: 1.4;
    color: var(--mmw-04);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .mmw-carousel-card__price {
    font-family: var(--mmw-font-label);
    font-weight: 700;
    font-size: 18px;
    text-transform: uppercase;
    color: var(--mmw-04);
  }

  .mmw-carousel-card__price--sale {
    color: var(--mmw-02);
  }

  .mmw-carousel-card__price-line {
    display: flex;
    align-items: baseline;
    gap: 6px;
  }

  .mmw-carousel-card__price-compare {
    font-family: var(--mmw-font-label);
    font-weight: 700;
    font-size: 12px;
    color: var(--mmw-04);
    text-decoration: line-through;
    opacity: 0.85;
  }

  .mmw-carousel-card__price-note {
    margin: 4px 0 0;
    font-family: var(--mmw-font-text);
    font-size: 10px;
    line-height: 1.4;
    color: var(--mmw-04);
    opacity: 0.85;
  }

  /* Wiersz ceny: cena po lewej, natywny quick-add po prawej, wyrównane w pionie do ceny.
     Odstęp quick-add od prawej krawędzi karty = padding body od lewej (24px), bo oba
     siedzą w tym samym .mmw-carousel-card__body (left/right: 24px) — symetria "za darmo"
     z flexa. */
  .mmw-carousel-card__price-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .mmw-carousel-card__price-block {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  /* Reskin natywnego quick-add — tylko nadpisania (pozycja + kolory marki),
     snippets/quick-add.liquid i jego globalny CSS zostają nietknięte. */
  .mmw-carousel-card__price-row .quick-add {
    position: static;
    inset: auto;
    pointer-events: auto;
    flex: 0 0 auto;
    --quick-add-mobile-display: var(--quick-add-display);
    --quick-add-mobile-opacity: 1;
  }

  /* .quick-add__product-form-component/.shopify-product-form mają w natywnym CSS
     container-type: inline-size + height:100%, licząc na to, że .quick-add (rodzic) ma
     position:absolute; inset:0 (pełny rozmiar karty) — w naszym układzie w linii (position:
     static, flex item) to size containment odcina formularz od jego własnej zawartości,
     więc guzik nie może urosnąć w pigułkę na hover. Zdejmujemy containment i sztywną
     wysokość, reszta (grid-template-columns na .add-to-cart-text__content) zostaje natywna. */
  .mmw-carousel-card__price-row .quick-add__product-form-component,
  .mmw-carousel-card__price-row .quick-add__product-form-component .shopify-product-form {
    height: auto;
  }

  .mmw-carousel-card__price-row .quick-add__product-form-component .shopify-product-form {
    container-type: normal;
  }

  .mmw-carousel-card__price-row .quick-add__button {
    position: static;
    opacity: 1;
    background: linear-gradient(var(--mmw-02, #fc7753) 0 100%) padding-box;
    color: var(--mmw-01, #5f312f);
  }

  .mmw-carousel-card__price-row .quick-add__button .add-to-cart-text {
    background: var(--mmw-02, #fc7753);
  }
{% endstylesheet %}
