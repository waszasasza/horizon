{%- doc -%}
  mmw-product-siblings — przełącznik produktów powiązanych (np. inne roczniki/pojemności tego
  samego wina). Źródło: product.metafields.custom.warianty (lista referencji produktowych).

  Renderuje TYLKO gdy lista ma >1 pozycję (pojedynczy produkt = nic się nie renderuje, zero
  pustych kontenerów). Bieżący produkt (porównanie po handle) = stan aktywny, bez linku.
  Layout: do 4 kafelków w jednym wierszu (Figma node 982:6118); przy większej liczbie —
  poziome przewijanie (kafelki nie kurczą się poniżej min-width): drag myszką lub strzałki na
  desktopie (snippets/slideshow-arrow.liquid, tylko ≥990px, ukryte w spoczynku — pokazują się
  na hover wiersza), natywny swipe na mobile. Customowy tor + wskaźnik pozycji (Figma node
  982:6964) zamiast natywnego scrollbara — chowa się w spoczynku, pokazuje na hover/focus i
  podczas aktywnego przewijania.

  @example
  {% render 'mmw-product-siblings' %}
{%- enddoc -%}
{%- liquid
  assign siblings = product.metafields.custom.warianty.value
-%}
{%- if siblings != blank and siblings.size > 1 -%}
  <div class="mmw-siblings-wrap" data-mmw-siblings>
    <div class="mmw-siblings-row">
      {%- render 'slideshow-arrow', action: 'previous', icon_style: 'arrow', icon_shape: 'circle' -%}
      {%- render 'slideshow-arrow', action: 'next', icon_style: 'arrow', icon_shape: 'circle' -%}
    <div class="mmw-siblings" role="list" aria-label="Warianty produktu">
      {%- for item in siblings -%}
        {%- if item != blank -%}
          {%- assign is_current = false -%}
          {%- if item.handle == product.handle -%}
            {%- assign is_current = true -%}
          {%- endif -%}
          {%- capture tile_media -%}
            <span class="mmw-siblings__media">
              {%- if item.featured_image != blank -%}
                <img
                  src="{{ item.featured_image | image_url: width: 92 }}"
                  srcset="{{ item.featured_image | image_url: width: 46 }} 46w, {{ item.featured_image | image_url: width: 92 }} 92w"
                  sizes="46px"
                  width="46" height="46"
                  alt=""
                  loading="lazy"
                >
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'mmw-siblings__media-placeholder' }}
              {%- endif -%}
            </span>
            <span class="mmw-siblings__title">{{ item.title }}</span>
          {%- endcapture -%}
          {%- if is_current -%}
            <div class="mmw-siblings__item mmw-siblings__item--active" role="listitem" aria-current="true">
              {{ tile_media }}
            </div>
          {%- else -%}
            <a class="mmw-siblings__item" role="listitem" href="{{ item.url }}">
              {{ tile_media }}
            </a>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
    </div>
    <div class="mmw-siblings__track" aria-hidden="true">
      <div class="mmw-siblings__indicator"></div>
    </div>
  </div>

  <script>
    (function () {
      document.querySelectorAll('[data-mmw-siblings]').forEach(function (wrap) {
        if (wrap.dataset.mmwSiblingsInit) return;
        wrap.dataset.mmwSiblingsInit = 'true';

        var scroller = wrap.querySelector('.mmw-siblings');
        var indicator = wrap.querySelector('.mmw-siblings__indicator');
        var prevButton = wrap.querySelector('[ref="previous"]');
        var nextButton = wrap.querySelector('[ref="next"]');
        if (!scroller || !indicator) return;

        var isDown = false;
        var startX = 0;
        var startScrollLeft = 0;
        var idleTimer = null;

        function showWhileActive() {
          wrap.classList.add('is-scrolling');
          clearTimeout(idleTimer);
          idleTimer = setTimeout(function () {
            wrap.classList.remove('is-scrolling');
          }, 1000);
        }

        function updateIndicator() {
          var scrollable = scroller.scrollWidth - scroller.clientWidth;
          var thumbPercent = Math.min(100, (scroller.clientWidth / scroller.scrollWidth) * 100);
          var progress = scrollable > 0 ? scroller.scrollLeft / scrollable : 0;
          indicator.style.width = thumbPercent + '%';
          indicator.style.left = (progress * (100 - thumbPercent)) + '%';

          if (prevButton) prevButton.disabled = scroller.scrollLeft <= 1;
          if (nextButton) nextButton.disabled = scroller.scrollLeft >= scrollable - 1;
        }

        scroller.addEventListener('scroll', function () {
          updateIndicator();
          showWhileActive();
        }, { passive: true });

        // Strzałki — natywny snippets/slideshow-arrow.liquid (te same klasy/ikona co w innych
        // karuzelach motywu), ale bez slideshow-component nie działa jego on:click="/next"
        // (nie ma do czego dispatchować), więc podpinamy własny scrollBy o "stronę" widoku.
        if (prevButton) {
          prevButton.addEventListener('click', function () {
            scroller.scrollBy({ left: -scroller.clientWidth * 0.8, behavior: 'smooth' });
          });
        }
        if (nextButton) {
          nextButton.addEventListener('click', function () {
            scroller.scrollBy({ left: scroller.clientWidth * 0.8, behavior: 'smooth' });
          });
        }

        // Drag-to-scroll myszką (desktop) — dotyk (mobile) zostaje w 100% natywny,
        // nie podpinamy się pod touchstart/touchmove, żeby nie psuć momentum scrolla.
        scroller.addEventListener('mousedown', function (e) {
          isDown = true;
          scroller.classList.add('is-dragging');
          startX = e.clientX;
          startScrollLeft = scroller.scrollLeft;
        });

        window.addEventListener('mousemove', function (e) {
          if (!isDown) return;
          e.preventDefault();
          scroller.scrollLeft = startScrollLeft - (e.clientX - startX);
        });

        function endDrag() {
          if (!isDown) return;
          isDown = false;
          scroller.classList.remove('is-dragging');
        }
        window.addEventListener('mouseup', endDrag);
        scroller.addEventListener('mouseleave', endDrag);

        updateIndicator();

        window.addEventListener('resize', updateIndicator);
      });
    })();
  </script>
{%- endif -%}

{% stylesheet %}
    /* Kontener scrolla jest jednocześnie display:flex (kafelki) i overflow-x:auto — ale flex/grid
       itemy mają domyślnie min-width:auto, więc bez min-width:0 na całym łańcuchu przodków
       (kolumna .product-details w gridzie media|details, .group-block, .group-block-content,
       nasz wrapper theme-blocku) kontener nigdy nie może zrobić się węższy niż jego treść —
       overflow-x:auto nie ma się wtedy z czego uruchomić. .product-details/.group-block/
       .group-block-content to natywne klasy Horizona (blocks/_product-details.liquid,
       snippets/group.liquid) — nie edytujemy tamtych plików, tylko domykamy łańcuch stąd,
       przez :has(), żeby trafić WYŁĄCZNIE w gałąź zawierającą ten komponent. */
    .product-details:has(.mmw-siblings),
    .group-block:has(.mmw-siblings),
    .group-block-content:has(.mmw-siblings) {
      min-width: 0;
    }

    .mmw-siblings-wrap {
      display: flex;
      flex-direction: column;
      gap: 10px;
      width: 100%;
      min-width: 0;
      max-width: 100%;
    }

    .mmw-siblings-row {
      position: relative;
    }

    /* Strzałki — natywny snippets/slideshow-arrow.liquid, tylko desktop (na mobile i tak
       przewija się swipe'em, strzałki tam nie mają sensu). Ukryte w spoczynku, pokazują się
       na hover wiersza/focus przycisku — ten sam wzorzec co przy .mmw-siblings__track. */
    .mmw-siblings-row .slideshow-control {
      display: none;
    }
    @media (min-width: 990px) {
      .mmw-siblings-row .slideshow-control {
        display: flex;
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        z-index: 1;
        opacity: 0;
        transition: opacity .2s ease;
      }
      .mmw-siblings-row .slideshow-control--previous { left: -6px; }
      .mmw-siblings-row .slideshow-control--next { right: -6px; }
      .mmw-siblings-row:hover .slideshow-control:not([disabled]),
      .mmw-siblings-row .slideshow-control:focus-visible {
        opacity: 1;
      }
      /* Disabled = całkowicie usunięte (nie tylko niewidoczne przez opacity) — bez tego
         strzałka na krawędzi, choć wizualnie ukryta, dałaby się wciąż zfocusować Tabem. */
      .mmw-siblings-row .slideshow-control[disabled] {
        display: none;
      }
    }

    .mmw-siblings {
      display: flex;
      gap: 10px;
      width: 100%;
      min-width: 0;
      max-width: 100%;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scroll-snap-type: x proximity;
      cursor: grab;
      /* Natywny scrollbar wyłączony — jego rolę przejmuje customowy .mmw-siblings__track
         poniżej (1:1 z Figmy, node 982:6964), sterowany JS-em zamiast CSS-owego skina. */
      scrollbar-width: none;
    }
    .mmw-siblings::-webkit-scrollbar { display: none; }
    .mmw-siblings.is-dragging {
      cursor: grabbing;
      user-select: none;
      scroll-snap-type: none;
    }

    /* Tor + wskaźnik pozycji — czysto dekoracyjne (aria-hidden), samo przewijanie idzie przez
       .mmw-siblings (drag myszką na desktopie, natywny swipe na mobile). Domyślnie niewidoczne,
       pokazują się na hover/focus oraz podczas aktywnego przewijania (klasa .is-scrolling
       dodawana w JS, zdejmowana ~1s po ostatnim scrollu) — tak jak przy natywnym znikającym
       scrollbarze na mobile. */
    .mmw-siblings__track {
      position: relative;
      height: 2px;
      border-radius: 99px;
      background: var(--MMW-400-stroke, rgba(95, 49, 47, 0.25));
      opacity: 0;
      transition: opacity .3s ease;
    }
    .mmw-siblings-wrap:hover .mmw-siblings__track,
    .mmw-siblings-wrap:focus-within .mmw-siblings__track,
    .mmw-siblings-wrap.is-scrolling .mmw-siblings__track {
      opacity: 1;
    }
    .mmw-siblings__indicator {
      position: absolute;
      top: 0;
      left: 0;
      height: 100%;
      border-radius: 99px;
      background: #5F312F;
    }

    .mmw-siblings__item {
      flex: 1 1 0;
      flex-shrink: 0;
      min-width: 140px;
      max-width: 220px;
      scroll-snap-align: start;
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 8px;
      border: 1px solid rgba(95, 49, 47, 0.25);
      border-radius: 6px;
      text-decoration: none;
      color: var(--mmw-01);
      background: transparent;
      transition: border-color .2s ease, background-color .2s ease;
    }
    a.mmw-siblings__item:hover,
    a.mmw-siblings__item:focus-visible {
      border-color: var(--mmw-01);
    }
    .mmw-siblings__item--active {
      border: 2px solid var(--mmw-01);
      background: var(--mmw-04);
      padding: 7px; /* -1px, żeby grubszy border nie przesunął treści względem sąsiadów */
      cursor: default;
    }

    .mmw-siblings__media {
      flex: 0 0 46px;
      width: 46px;
      height: 46px;
      border-radius: 4px;
      overflow: hidden;
      background: var(--mmw-04);
      display: block;
    }
    .mmw-siblings__media img,
    .mmw-siblings__media svg {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    .mmw-siblings__item--active .mmw-siblings__media { background: var(--mmw-03); }

    .mmw-siblings__title {
      margin: 0;
      font-family: var(--mmw-font-text);
      font-size: 14px;
      line-height: 1.3;
      color: var(--mmw-01);
      display: -webkit-box;
      -webkit-line-clamp: 2;
      line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      min-width: 0;
    }
  {% endstylesheet %}
