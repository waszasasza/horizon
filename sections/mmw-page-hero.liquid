{%- comment -%}
  mmw-page-hero — scalenie mmw-hero + mmw-blog-hero + mmw-firms-hero +
  mmw-history-hero w jedną sekcję, od razu z obsługą wideo w tle. Patrz
  CLAUDE.md, sekcja „Czego NIE ruszać" — WYJĄTEK dopisany tam dla tego
  scalenia (blog/firms/history-hero zdjęte z listy).

  Pole obrazu ujednolicone na "image" (w mmw-hero było "background_image")
  — przy migracji index.json trzeba przemianować klucz w settings, sama
  podmiana "type" nie wystarczy.

  Wideo — NIE deferred-media (to mechanizm kliknij-i-odtwórz z
  mmw-product-video-hero, tu potrzebny autoplay). Też NIE render 'video'
  (ten sam powód). Horizon nie ma osobnego snippetu do wideo w tle —
  natywna sections/hero.liquid używa wprost filtra Liquid `video_tag`,
  bez pośredniego pliku/snippetu, więc nie ma tu ryzyka z per-page
  subsettingiem (nie ma czego nie wyrenderować, patrz CLAUDE.md, sekcja
  o awarii karuzel). Poster NIE jest atrybutem video (video_tag: poster:
  nil w natywnym hero.liquid) — jest osobnym <img>, żeby to on był
  elementem LCP z własnym srcset, a nie atrybut poster (słabiej wspierany
  jako kandydat LCP, bez srcset).

  Mobile → obraz zamiast wideo: NIE przez JS/CSS display:none (video
  z autoplay bywa i tak pobierane w tle zależnie od przeglądarki) — przez
  <source media="(min-width: 750px)"> na KAŻDYM źródle wideo. Gdy żadne
  <source> nie pasuje do bieżącej szerokości viewportu, przeglądarka nie
  pobiera żadnych bajtów wideo, więc poster pod spodem zostaje jedyną
  widoczną warstwą — czysty HTML, zero JS, gwarancja braku pobrania
  (nie heurystyka).

  prefers-reduced-motion: brak wzorca natywnego do przejęcia (sprawdzone:
  sections/hero.liquid go nie obsługuje) — czysty CSS niżej, video
  chowane, poster zostaje.

  Gdy background_type = video, ale pole video puste: has_video poniżej
  wychodzi false, więc <video> w ogóle się nie renderuje (bez pustego
  kontenera) — zachowanie identyczne jak przy background_type = image.
{%- endcomment -%}
{%- liquid
  assign bg_type = section.settings.background_type | default: 'image'
  assign has_video = false
  if bg_type == 'video' and section.settings.video != blank
    assign has_video = true
  endif
  assign source_media = ''
  if section.settings.video_mobile_image_fallback
    assign source_media = ' media="(min-width: 750px)"'
  endif
-%}
{%- style -%}
  #shopify-section-{{ section.id }} .mmw-page-hero {
    position: relative;
    min-height: {{ section.settings.height }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: {{ section.settings.padding_block }}px 20px;
    overflow: hidden;
    background-color: var(--mmw-01);
  }
  #shopify-section-{{ section.id }} .mmw-page-hero__bg,
  #shopify-section-{{ section.id }} .mmw-page-hero__bg svg,
  #shopify-section-{{ section.id }} .mmw-page-hero__bg-video {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    z-index: 0;
  }
  #shopify-section-{{ section.id }} .mmw-page-hero__overlay {
    position: absolute; inset: 0; z-index: 1;
    background: rgba(0, 0, 0, {{ section.settings.overlay_opacity | divided_by: 100.0 }});
  }
  #shopify-section-{{ section.id }} .mmw-page-hero__inner {
    position: relative; z-index: 2;
    display: flex; flex-direction: column; align-items: center;
    gap: 53px; text-align: center;
  }
  #shopify-section-{{ section.id }} .mmw-page-hero__logo { width: 270px; max-width: 70vw; height: auto; }
  #shopify-section-{{ section.id }} .mmw-page-hero__heading {
    margin: 0;
    font-family: var(--mmw-font-display);
    font-weight: 400;
    font-size: {{ section.settings.heading_size }}px;
    line-height: {{ section.settings.heading_line_height }};
    color: var(--mmw-04);
    max-width: 560px;
  }
  #shopify-section-{{ section.id }} .mmw-page-hero__sub {
    margin: 0;
    font-family: var(--mmw-font-text);
    font-size: 16px;
    line-height: 1.4;
    color: var(--mmw-04);
    max-width: 442px;
  }
  #shopify-section-{{ section.id }} .mmw-page-hero__buttons {
    display: flex; flex-wrap: wrap; gap: 37px; justify-content: center;
  }
  #shopify-section-{{ section.id }} .mmw-btn {
    display: inline-flex; align-items: center; justify-content: center;
    padding: 10px 48px;
    border-radius: 50px;
    font-family: var(--mmw-font-label);
    font-weight: 700;
    font-size: var(--mmw-button-size);
    letter-spacing: var(--mmw-label-tracking);
    text-transform: uppercase;
    text-decoration: none;
    transition: opacity .2s ease;
  }
  #shopify-section-{{ section.id }} .mmw-btn:hover { opacity: .85; }
  #shopify-section-{{ section.id }} .mmw-btn--dark   { background: var(--mmw-01); color: var(--mmw-02); }
  #shopify-section-{{ section.id }} .mmw-btn--light  { background: var(--mmw-04); color: var(--mmw-01); }
  #shopify-section-{{ section.id }} .mmw-btn--accent { background: var(--mmw-02); color: var(--mmw-04); }

  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .mmw-page-hero__heading {
      font-size: {{ section.settings.heading_size | times: 0.55 | round }}px;
    }
    #shopify-section-{{ section.id }} .mmw-page-hero__inner { gap: 32px; }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .mmw-page-hero__bg-video { display: none; }
  }
{%- endstyle -%}

<section class="mmw-page-hero">
  {%- if section.settings.image -%}
    <img
      class="mmw-page-hero__bg"
      src="{{ section.settings.image | image_url: width: 2400 }}"
      srcset="{{ section.settings.image | image_url: width: 1200 }} 1200w,
              {{ section.settings.image | image_url: width: 2400 }} 2400w"
      sizes="100vw"
      alt=""
      loading="eager"
      fetchpriority="high"
      width="{{ section.settings.image.width }}"
      height="{{ section.settings.image.height }}"
    >
  {%- else -%}
    {{ 'lifestyle-1' | placeholder_svg_tag: 'mmw-page-hero__bg' }}
  {%- endif -%}

  {%- if has_video -%}
    <video class="mmw-page-hero__bg-video" autoplay muted loop playsinline aria-hidden="true">
      {%- for source in section.settings.video.sources -%}
        <source src="{{ source.url }}" type="{{ source.mime_type }}"{{ source_media }}>
      {%- endfor -%}
    </video>
  {%- endif -%}

  <div class="mmw-page-hero__overlay"></div>

  <div class="mmw-page-hero__inner">
    {%- if section.settings.logo -%}
      <img class="mmw-page-hero__logo"
           src="{{ section.settings.logo | image_url: width: 540 }}"
           alt="{{ shop.name | escape }}" width="270" height="auto" loading="eager">
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h1 class="mmw-page-hero__heading">{{ section.settings.heading }}</h1>
    {%- endif -%}

    {%- if section.settings.subtitle != blank -%}
      <p class="mmw-page-hero__sub">{{ section.settings.subtitle }}</p>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="mmw-page-hero__buttons">
        {%- for block in section.blocks -%}
          {%- if block.type == 'button' and block.settings.label != blank -%}
            <a href="{{ block.settings.link | default: '#' }}"
               class="mmw-btn mmw-btn--{{ block.settings.style }}"
               {{ block.shopify_attributes }}>
              {{ block.settings.label }}
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "MMW Hero strony",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Tło" },
    {
      "type": "select",
      "id": "background_type",
      "label": "Typ tła",
      "default": "image",
      "options": [
        { "value": "image", "label": "Obraz" },
        { "value": "video", "label": "Wideo" }
      ]
    },
    { "type": "image_picker", "id": "image", "label": "Zdjęcie tła", "info": "Używane jako tło przy typie „Obraz” oraz jako plakat i zapasowe tło na mobile przy typie „Wideo”." },
    { "type": "video", "id": "video", "label": "Wideo (hostowane w Shopify)", "visible_if": "{{ section.settings.background_type == 'video' }}" },
    { "type": "checkbox", "id": "video_mobile_image_fallback", "label": "Na mobile pokaż obraz zamiast wideo", "info": "Zalecane — wideo w tle na łączu komórkowym to realny koszt transferu.", "default": true, "visible_if": "{{ section.settings.background_type == 'video' }}" },
    { "type": "range", "id": "overlay_opacity", "min": 0, "max": 80, "step": 5, "unit": "%", "label": "Przyciemnienie tła", "default": 30 },

    { "type": "header", "content": "Treść" },
    { "type": "image_picker", "id": "logo", "label": "Logo / sygnet (opcjonalnie)" },
    { "type": "text", "id": "heading", "label": "Nagłówek", "default": "Jabłko. Tradycja. Smak." },
    { "type": "range", "id": "heading_size", "min": 40, "max": 96, "step": 2, "unit": "px", "label": "Rozmiar nagłówka", "default": 80 },
    { "type": "range", "id": "heading_line_height", "min": 0.8, "max": 1.3, "step": 0.1, "label": "Interlinia nagłówka", "default": 1.1, "info": "Suwak w krokach 0.1 — wartość 0.97 (dziedziczona z blog/firms/history-hero) jest ustawiona wprost w JSON-ie szablonu i wyświetli się poprawnie, mimo że leży między krokami suwaka." },
    { "type": "textarea", "id": "subtitle", "label": "Podtytuł" },

    { "type": "header", "content": "Wygląd" },
    { "type": "range", "id": "height", "min": 400, "max": 1000, "step": 20, "unit": "px", "label": "Wysokość sekcji", "default": 720 },
    { "type": "range", "id": "padding_block", "min": 20, "max": 120, "step": 4, "unit": "px", "label": "Odstęp góra/dół", "default": 80 }
  ],
  "blocks": [
    {
      "type": "button",
      "name": "Przycisk",
      "settings": [
        { "type": "text", "id": "label", "label": "Tekst", "default": "SKLEP" },
        { "type": "url", "id": "link", "label": "Link" },
        {
          "type": "select", "id": "style", "label": "Styl", "default": "dark",
          "options": [
            { "value": "dark",   "label": "Ciemny (brąz)" },
            { "value": "light",  "label": "Jasny (krem)" },
            { "value": "accent", "label": "Akcent (koral)" }
          ]
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "MMW Hero strony",
      "settings": { "heading": "Jabłko. Tradycja. Smak.", "overlay_opacity": 30, "heading_size": 80, "heading_line_height": 1.1, "height": 720, "padding_block": 80 }
    }
  ]
}
{% endschema %}
