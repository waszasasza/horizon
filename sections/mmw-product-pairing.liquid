{%- comment -%}
  mmw-product-pairing — "Polecamy do": propozycje podania produktu (kafelki obraz+
  tytuł+opis). Nagłówek/opis z ustawień edytora (nie metapola). Kafelki: metaobjekt
  polecamy_do (pola: tytul, opis, obraz), product.metafields.custom.polecamy_do.
  Renderuje się TYLKO gdy lista kafelków niepusta — inaczej cała sekcja (razem
  z nagłówkiem) znika.
  Figma: plik STRONA-WWW, node 982:6305.
{%- endcomment -%}
{%- liquid
  assign pairings = product.metafields.custom.polecamy_do.value
-%}
{%- if pairings != blank and pairings.size > 0 -%}
  <section class="mmw-pairing section color-{{ section.settings.color_scheme }}">
    {%- if section.settings.heading != blank or section.settings.description != blank -%}
      <div class="mmw-pairing__head">
        {%- if section.settings.heading != blank -%}
          <h2 class="mmw-pairing__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <p class="mmw-pairing__description">{{ section.settings.description }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}
    <div class="mmw-pairing__grid">
      {%- for item in pairings -%}
        {%- if item != blank -%}
          {%- liquid
            assign tile_title = item.tytul.value
            assign tile_desc = item.opis.value
            assign tile_image = item.obraz.value
          -%}
          <div class="mmw-pairing__tile">
            {%- if tile_image != blank -%}
              <div class="mmw-pairing__media">
                <img
                  class="mmw-pairing__img"
                  src="{{ tile_image | image_url: width: 450 }}"
                  srcset="
                    {{ tile_image | image_url: width: 225 }} 225w,
                    {{ tile_image | image_url: width: 450 }} 450w,
                    {{ tile_image | image_url: width: 675 }} 675w
                  "
                  sizes="225px"
                  width="225"
                  height="250"
                  alt="{{ tile_title | default: product.title | escape }}"
                  loading="lazy"
                >
              </div>
            {%- endif -%}
            {%- if tile_title != blank or tile_desc != blank -%}
              <div class="mmw-pairing__body">
                {%- if tile_title != blank -%}
                  <p class="mmw-pairing__title">{{ tile_title }}</p>
                {%- endif -%}
                {%- if tile_desc != blank -%}
                  <p class="mmw-pairing__desc">{{ tile_desc }}</p>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </section>
{%- endif -%}

{% stylesheet %}
  /* .section wyłącznie po to, żeby odziedziczyć --util-page-margin-offset
     (assets/base.css). Compound selector .mmw-pairing.section ma wyższą
     specyficzność niż samo .section, więc nadpisuje jego display:grid z
     powrotem na nasz flex, niezależnie od kolejności ładowania arkuszy —
     dedykowany blok stylów tej sekcji nie jest scopowany po ID sekcji, więc
     specyficzność (nie ID) musi wystarczyć. Ten sam cel co ID-scoped reguła
     w mmw-product-carousel.liquid, inny mechanizm bo inny sposób stylowania. */
  .mmw-pairing.section {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 30px;
    padding-block: 60px;
    padding-inline: var(--util-page-margin-offset, var(--page-margin, 40px));
  }

  .mmw-pairing__head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    text-align: center;
    color: var(--mmw-01);
  }

  .mmw-pairing__heading {
    margin: 0;
    font-family: var(--mmw-font-display);
    font-weight: 400;
    font-size: 60px;
    line-height: 1;
  }

  .mmw-pairing__description {
    margin: 0;
    max-width: 480px;
    font-family: var(--mmw-font-text);
    font-size: 16px;
    line-height: 1.4;
  }

  .mmw-pairing__grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 28px;
    width: 100%;
  }

  .mmw-pairing__tile {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    width: 225px;
  }

  .mmw-pairing__media {
    width: 225px;
    height: 250px;
    border-radius: 20px;
    overflow: hidden;
  }

  .mmw-pairing__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .mmw-pairing__body {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    width: 100%;
    text-align: center;
    color: var(--mmw-01);
  }

  .mmw-pairing__title {
    margin: 0;
    font-family: var(--mmw-font-label);
    font-weight: 700;
    font-size: 15px;
    line-height: 20px;
    letter-spacing: 0.7px;
    text-transform: uppercase;
  }

  .mmw-pairing__desc {
    margin: 0;
    font-family: var(--mmw-font-text);
    font-size: 16px;
    line-height: 1.4;
  }

  @media (max-width: 749px) {
    .mmw-pairing.section {
      padding-block: 40px;
      gap: 24px;
    }

    .mmw-pairing__heading {
      font-size: 44px;
    }

    .mmw-pairing__description {
      max-width: 100%;
    }

    .mmw-pairing__grid {
      flex-direction: column;
      align-items: center;
    }

    .mmw-pairing__tile {
      width: 100%;
      max-width: 320px;
    }

    .mmw-pairing__media {
      width: 100%;
      height: auto;
      aspect-ratio: 225 / 250;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "MMW Polecamy do",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Nagłówek",
      "default": "Polecamy do"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Opis",
      "default": "Smaki, aromaty i historie zamknięte w markach tworzonych w sercu Majątku Mała Wieś. Poznaj je wszystkie."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    { "name": "MMW Polecamy do", "category": "t:categories.product" }
  ]
}
{% endschema %}
