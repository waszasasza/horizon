{%- comment -%}
  mmw-product-pairing — "Polecamy do": propozycje podania produktu, jako natywna
  karuzela Horizon — DOKŁADNIE ten sam wzorzec co mmw-product-carousel.liquid:
  slideshow + slideshow-slide + slideshow-controls + gutter/peek-width 1:1 z
  snippets/resource-list.liquid i snippets/resource-list-carousel.liquid. Snippety
  NIE są modyfikowane — cała mechanika (snap, strzałki na hover, gutter/padding
  pasa, zachowanie przy krótkiej liście) pochodzi z assets/slideshow.js i
  snippets/slideshow*.liquid/resource-list*.liquid, tak jak w karuzeli bestsellerów.

  Nagłówek i opis pod nim: ustawienia sekcji (editor), NIE metapola.
  Kafelki: product.metafields.custom.polecamy_do — lista referencji do
  metaobjektu polecamy_do (pola: tytul, opis, obraz, opcjonalnie link — jeśli
  pole nie istnieje w definicji metaobjektu, po prostu nigdy się nie wypełni
  i kafelek renderuje się bez linku, bez błędu).

  Renderuje się TYLKO gdy lista kafelków niepusta — inaczej cała sekcja
  (razem z nagłówkiem) znika. Bezpieczna iteracja: wpis może być usunięty,
  obraz pusty — wartości czytane przez .value, wadliwe pozycje pomijane.

  Figma: plik STRONA-WWW, node 982:6305.
{%- endcomment -%}
{%- liquid
  assign pairings = product.metafields.custom.polecamy_do.value
-%}
{%- if pairings != blank and pairings.size > 0 -%}
  {%- comment -%} Kafelki → tablica HTML (ten sam trik co cards_concat w mmw-product-carousel.liquid). {%- endcomment -%}
  {%- capture tiles_concat -%}
    {%- assign tile_index = 0 -%}
    {%- for item in pairings -%}
      {%- if item != blank -%}
        {%- if tile_index > 0 -%}<!--@mmw-pairing/split-->{%- endif -%}
        {%- assign tile_index = tile_index | plus: 1 -%}
        {%- liquid
          assign tile_title = item.tytul.value
          assign tile_desc = item.opis.value
          assign tile_image = item.obraz.value
          # Pole "link" jest typu URL (link), zwraca obiekt {text, url} — nie string.
          # Sam tekst linku jest nam zbędny (link owija cały kafelek, a-11y idzie
          # z tytułu), więc bierzemy tylko .url.
          assign tile_link = item.link.value.url
        -%}
        <div class="mmw-pairing__tile">
          {%- if tile_link != blank -%}
            <a class="mmw-pairing__tile-link" href="{{ tile_link }}">
              <span class="visually-hidden">{{ tile_title | default: product.title | escape }}</span>
            </a>
          {%- endif -%}
          {%- if tile_image != blank -%}
            <div class="mmw-pairing__media">
              <img
                class="mmw-pairing__img"
                loading="lazy"
                width="225"
                height="250"
                src="{{ tile_image | image_url: width: 450 }}"
                srcset="
                  {{ tile_image | image_url: width: 225 }} 225w,
                  {{ tile_image | image_url: width: 450 }} 450w,
                  {{ tile_image | image_url: width: 675 }} 675w
                "
                sizes="(max-width: 749px) 60cqw, 280px"
                alt=""
              >
            </div>
          {%- endif -%}
          {%- if tile_title != blank or tile_desc != blank -%}
            <div class="mmw-pairing__body">
              {%- if tile_title != blank -%}
                <p class="mmw-pairing__title">{{ tile_title }}</p>
              {%- endif -%}
              {%- if tile_desc != blank -%}
                <p class="mmw-pairing__desc">{{ tile_desc }}</p>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}
  {%- assign tiles_array = tiles_concat | strip | split: '<!--@mmw-pairing/split-->' -%}

  {%- comment -%}
    Od tego miejsca w dół — logika 1:1 skopiowana z mmw-product-carousel.liquid
    (samo pochodzi z snippets/resource-list.liquid + snippets/resource-list-carousel.liquid).
  {%- endcomment -%}
  {%- comment -%}
    --column-count: 5 na desktopie (container query ≥750px w resource-list-carousel.liquid
    liczy szerokość slajdu z tej wartości: (100% - gap*(count-1) - peek) / count) — mobile
    nieruszone, bo tam szerokość idzie z zupełnie innej gałęzi (clamp z --mobile-card-size).
  {%- endcomment -%}
  {%- capture resource_list_style -%}
    --resource-list-column-gap-desktop: 28px;
    --column-count: 5;
    --column-count-mobile: 1;
    --mobile-card-size: 60cqw;
  {%- endcapture -%}

  {%- liquid
    assign carousel_ref = 'mmwPairing-' | append: section.id
    # Gutter 1:1 jak w mmw-product-carousel.liquid / resource-list-carousel.liquid: div ze
    # zmiennymi wokół <slideshow-component>, gutters="start end" generuje ślepe guttery
    # o szerokości --gutter-slide-width na początku/końcu pasa — jedyny mechanizm
    # wyrównania skrajnych kart, bez żadnego własnego paddingu z naszej strony.
    assign slideshow_gutters = 'start end'
    assign gutter_style = '--gutter-slide-width: var(--util-page-margin-offset, var(--page-margin, 40px)); --slide-width-max: 280px;'

    # Strzałki tylko gdy jest co przewijać na desktopie: --column-count (wyżej) = 5,
    # więc przy <=5 kafelkach cały rząd mieści się bez scrolla. Liczone z Liquid
    # (znany w czasie renderu tiles_array.size i stała liczba kolumn), nie z JS —
    # natywny atrybut [disabled] na strzałkach nie ukrywa ich, tylko wyszarza.
    # Mobile i tak chowa strzałki całkowicie w CSS (@media max-width:749px) niżej,
    # więc ten warunek dotyczy wyłącznie desktopu.
    assign show_arrows = false
    if tiles_array.size > 5
      assign show_arrows = true
    endif
  -%}
  {%- capture carousel_slides -%}
    {%- for item in tiles_array -%}
      {%- render 'slideshow-slide', index: forloop.index0, children: item, class: 'resource-list__slide' -%}
    {%- endfor -%}
  {%- endcapture -%}
  {%- capture carousel_controls -%}
    {%- render 'slideshow-controls', style: 'dots', item_count: tiles_array.size, show_arrows: false, pagination_position: 'center' -%}
  {%- endcapture -%}

  <section class="mmw-pairing section color-{{ section.settings.color_scheme }}{% unless show_arrows %} mmw-pairing--fits-desktop{% endunless %}">
    {%- if section.settings.heading != blank or section.settings.description != blank -%}
      <div class="mmw-pairing__head">
        {%- if section.settings.heading != blank -%}
          <h2 class="mmw-pairing__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <p class="mmw-pairing__description">{{ section.settings.description }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="resource-list resource-list__carousel mmw-pairing__carousel-wrap" style="{{ resource_list_style }}">
      <div style="{{ gutter_style }}">
        {%- render 'slideshow',
          ref: carousel_ref,
          class: 'resource-list__carousel',
          slides: carousel_slides,
          show_arrows: show_arrows,
          icon_style: 'arrow',
          icon_shape: 'circle',
          auto_hide_controls: true,
          infinite: false,
          initial_slide: 0,
          slide_count: tiles_array.size,
          slideshow_gutters: slideshow_gutters,
          controls: carousel_controls
        -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% stylesheet %}
  /* .section wyłącznie po to, żeby odziedziczyć --util-page-margin-offset
     (assets/base.css). Compound selector .mmw-pairing.section ma wyższą
     specyficzność niż samo .section, więc nadpisuje jego display:grid z
     powrotem na nasz flex — ten sam cel co ID-scoped reguła w
     mmw-product-carousel.liquid, inny mechanizm bo ten dedykowany blok
     stylów tej sekcji nie jest scopowany po ID sekcji jak klasyczny
     mechanizm stylowania z tamtego pliku. */
  .mmw-pairing.section {
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding-block: 60px;
  }

  .mmw-pairing__head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    text-align: center;
    color: var(--mmw-01);
    padding-inline: var(--util-page-margin-offset, var(--page-margin, 40px));
  }

  .mmw-pairing__heading {
    margin: 0;
    font-family: var(--mmw-font-display);
    font-weight: 400;
    font-size: 60px;
    line-height: 1;
  }

  .mmw-pairing__description {
    margin: 0;
    max-width: 480px;
    font-family: var(--mmw-font-text);
    font-size: 16px;
    line-height: 1.4;
  }

  /* Karuzela: wrapper 1:1 jak w snippets/resource-list.liquid dla layout_type: "carousel" */
  .mmw-pairing__carousel-wrap {
    width: 100%;
  }

  .mmw-pairing__carousel-wrap .resource-list__slide {
    scroll-snap-align: start;
  }

  .mmw-pairing slideshow-slides {
    padding-inline-start: var(--util-page-margin-offset, var(--page-margin, 40px)) !important;
    padding-inline-end: var(--util-page-margin-offset, var(--page-margin, 40px)) !important;
    scroll-padding-inline-start: var(--util-page-margin-offset, var(--page-margin, 40px)) !important;
    /* Domyślnie align-items: normal ≈ stretch — rozciąga wszystkie slajdy do
       wspólnej wysokości najwyższego. U nas kafelek to obraz + tekst w stosie
       (nie nałożony absolutnie jak w mmw-carousel-card), więc bywa wyższy niż
       natywny slideshow-slide { max-height: 100% } na to pozwala — stretch +
       ta natywna reguła obcinały kafelek. start = brak rozciągania. */
    align-items: start;
  }

  .mmw-pairing .resource-list__slide,
  .mmw-pairing slideshow-slide {
    scroll-snap-align: start;
    /* Zdejmujemy natywny limit wysokości slajdu (slideshow-styles.liquid:
       max-height: 100%; overflow: hidden) TYLKO w scope tej sekcji — kafelek
       (obraz + tytuł + opis w normalnym flow) bywa wyższy niż sam obraz i był
       przez to obcinany. overflow-x zostaje hidden, żeby nie rozjechać
       szerokości/scrollowania pasa — tniemy tylko oś pionową. */
    max-height: none;
    overflow-x: hidden;
    overflow-y: visible;
    align-self: start;
  }

  /* Kropki wyśrodkowane pod karuzelą (native .slideshow-controls__dots) — kolory przez
     zmienne komponentu, bez twardych selektorów. Natywnie kropki są barwione przez
     mix-blend-mode: difference (myślane pod kropki na zdjęciu/mediach) — u nas stoją
     na tle sekcji, więc wyłączamy to i barwimy wprost — ten sam wyjątek co w
     mmw-product-carousel.liquid. */
  .mmw-pairing slideshow-controls {
    margin-top: 8px;
    mix-blend-mode: normal!important;
    --color: rgba(95, 49, 47, 0.25);
    --color-active: var(--mmw-01, #5f312f);
    --color-hover: rgba(95, 49, 47, 0.4);
  }

  /* Kropki na desktopie: auto-hide-controls (natywny JS, mierzy scrollWidth vs
     offsetWidth) nie chował ich niezawodnie przy pierwszym renderze — pomiar
     najwyraźniej łapie moment przed ostatecznym layoutem/container query.
     Ten sam warunek co przy strzałkach (--column-count: 5, policzone w Liquid
     jako show_arrows), tylko doklejony jako klasa na sekcji: przy <=5 kafelkach
     desktop nigdy nie scrolluje, więc kropki są tam zbędne bez względu na
     dokładną szerokość viewportu ≥750px. Mobile (auto-hide-controls z JS)
     zostaje bez zmian. */
  @media (min-width: 750px) {
    .mmw-pairing--fits-desktop slideshow-controls {
      display: none;
    }

    /* Przy <=5 kafelkach rząd nie scrolluje (patrz show_arrows wyżej) i mieści się
       w całości między gutterami — bez tego domyślny justify-content: flex-start
       natywnego slideshow-slides (display:flex) zostawia kafelki przyklejone do
       lewej, z pustym miejscem po prawej. Wyśrodkowanie dotyczy tylko tego wariantu:
       przy >5 kafelkach rząd i tak wypełnia/scrolluje całą szerokość, więc flex-start
       zostaje (potrzebny do poprawnego scrolla od pierwszej karty). */
    .mmw-pairing--fits-desktop slideshow-slides {
      justify-content: center;
    }
  }

  /* Treść kafelka (nie geometria slajdu — to daje resource-list-carousel) */
  .mmw-pairing__tile {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    width: 100%;
  }

  .mmw-pairing__tile-link {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .mmw-pairing__media {
    position: relative;
    width: 100%;
    aspect-ratio: 225 / 250;
    border-radius: 20px;
    overflow: hidden;
  }

  .mmw-pairing__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .mmw-pairing__body {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    width: 100%;
    text-align: center;
    color: var(--mmw-01);
  }

  .mmw-pairing__title {
    margin: 0;
    font-family: var(--mmw-font-label);
    font-weight: 700;
    font-size: 15px;
    line-height: 20px;
    letter-spacing: 0.7px;
    text-transform: uppercase;
  }

  .mmw-pairing__desc {
    margin: 0;
    font-family: var(--mmw-font-text);
    font-size: 16px;
    line-height: 1.4;
  }

  @media (max-width: 989px) {
    .mmw-pairing.section {
      padding-block: 40px;
      gap: 24px;
    }

    .mmw-pairing__heading {
      font-size: 44px;
    }
  }

  @media (max-width: 749px) {
    /* Mobile: jedna karta na ekran, wycentrowana, ze skrawkami sąsiadów po bokach —
       ten sam mechanizm co --mmw-pc-gutter-mobile w mmw-product-carousel.liquid. */
    .mmw-pairing {
      --mmw-pairing-gutter-mobile: 24px;
    }

    .mmw-pairing__head {
      padding-inline: var(--mmw-pairing-gutter-mobile);
    }

    .mmw-pairing__description {
      max-width: 100%;
    }

    .mmw-pairing slideshow-arrows {
      display: none;
    }

    .mmw-pairing slideshow-slides {
      padding-inline-start: var(--mmw-pairing-gutter-mobile) !important;
      padding-inline-end: var(--mmw-pairing-gutter-mobile) !important;
      scroll-padding-inline-start: var(--mmw-pairing-gutter-mobile) !important;
      scroll-padding-inline-end: var(--mmw-pairing-gutter-mobile) !important;
    }

    .mmw-pairing__carousel-wrap .resource-list__slide {
      --slide-width: calc((100vw - 2 * var(--mmw-pairing-gutter-mobile) + 12px) * 0.85);
    }

    .mmw-pairing .resource-list__slide,
    .mmw-pairing slideshow-slide {
      scroll-snap-align: center;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "MMW Polecamy do",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Nagłówek",
      "default": "Polecamy do"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Opis",
      "default": "Smaki, aromaty i historie zamknięte w markach tworzonych w sercu Majątku Mała Wieś. Poznaj je wszystkie."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    { "name": "MMW Polecamy do", "category": "t:categories.product" }
  ]
}
{% endschema %}
