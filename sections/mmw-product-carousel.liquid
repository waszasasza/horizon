{%- comment -%}
  mmw-product-carousel — UNIWERSALNA karuzela produktowa (Figma: BESTSELLERS, karta node 982:4042).
  Źródło: kolekcja + limit kart — jedna sekcja obsługuje bestsellery ×2, vouchery i produkty marki,
  bez osobnych wariantów.
  Customowa jest wyłącznie treść karty: obraz (+ hover na drugie zdjęcie, CSS-owy fallback —
  natywny card-gallery hover-image wymaga zagnieżdżonego slideshow per karta, którego nasz
  pełnokadrowy layout nie używa), badge (tagi bestseller/nowość lub cena promocyjna), tytuł,
  opis (metapole custom.opis_karty, fallback na opis produktu), cena, karta końcowa.
{%- endcomment -%}
{%- liquid
  assign coll = section.settings.collection
  assign count = section.settings.products_count | default: 8
  assign show_end_card = section.settings.show_end_card
  assign desc_len = section.settings.description_length | default: 140

  assign columns = section.settings.columns | default: 3
  assign columns_gap = section.settings.columns_gap | default: 24
  assign mobile_card_size = section.settings.mobile_card_size | default: '60cqw'

  # sizes dla <img> karty (snippets/mmw-carousel-card.liquid) — cqw jest nieprawidłowe
  # w atrybucie HTML sizes (tylko <length>/funkcje matematyczne, viewport nie container),
  # więc liczymy realny odpowiednik w vw z tych samych ustawień sekcji co CSS:
  # - desktop: (100% - gap*(columns-1) - peek) / columns, peek = --peek-next-slide-size
  #   (theme-styles-variables.liquid, 3rem = 48px), 100% = 100vw bo .mmw-pc jest full-bleed
  #   (bez schema "class":"section" — brak grid/page-width confinement, sprawdzone w łańcuchu
  #   main > .content-for-layout > body/html, nigdzie max-width).
  # - mobile: ten sam clamp co resource-list-carousel.liquid, cqw→vw (liczbowo równoważne,
  #   bo kontener też jest full-bleed), mobile_card_size zagwarantowane non-nil przez default
  #   wyżej — drugi "| default" tutaj to lokalna gwarancja, niezależna od kolejności linii.
  # 400 = --slide-width-max z gutter_style niżej (literał, nie zmienna Liquid w tym pliku)
  assign gaps_and_peek = columns | minus: 1 | times: columns_gap | plus: 48
  assign mobile_vw = mobile_card_size | default: '60cqw' | replace: 'cqw', 'vw'
  assign card_sizes = 'auto, (max-width: 749px) clamp(150px, ' | append: mobile_vw | append: ', 400px), calc((100vw - ' | append: gaps_and_peek | append: 'px) / ' | append: columns | append: ')'

  case section.settings.card_ratio
    when 'portrait'
      assign card_ratio = '4 / 5'
    when 'square'
      assign card_ratio = '1 / 1'
    else
      assign card_ratio = '331 / 507'
  endcase
-%}
{%- if coll != blank and coll.products.size > 0 -%}
  {%- style -%}
    /* Wyrównanie poziome — WYŁĄCZNIE przez natywny mechanizm gutterów resource-list-carousel
       (nie własny padding). .mmw-pc dostaje klasę .section TYLKO po to, żeby odziedziczyć
       policzoną zmienną --util-page-margin-offset (assets/base.css, zdefiniowana w regule
       .section) — celowo BEZ display:grid: nasza własna reguła #id .mmw-pc{display:flex}
       ma wyższą specyficzność (ID) niż .section{display:grid} (sama klasa), więc nadpisuje
       go z powrotem na flex i cały mechanizm grid-template-columns/force-full-width (źródło
       poprzedniego rozciągania strony) zostaje całkowicie nieaktywny — bierzemy ze .section
       tylko zmienną, nie layout. .mmw-pc__head wyrównuje się tą samą zmienną. */
    #shopify-section-{{ section.id }} .mmw-pc { display: flex; flex-direction: column; gap: 32px; padding-block: 60px; }
    #shopify-section-{{ section.id }} .mmw-pc__head { display: flex; flex-direction: column; gap: 10px; color: var(--mmw-01); padding-inline: var(--util-page-margin-offset, var(--page-margin, 40px)); }
    #shopify-section-{{ section.id }} .mmw-pc__title { margin: 0; font-family: var(--mmw-font-display); font-weight: 400; font-size: 50px; line-height: 1; }
    #shopify-section-{{ section.id }} .mmw-pc__desc { margin: 0; font-family: var(--mmw-font-text); font-size: 16px; line-height: 1.4; max-width: 640px; }

    /* Karta produktu: snippets/mmw-carousel-card.liquid (współdzielona z
       mmw-product-recommendations.liquid) — tylko przekazujemy card_ratio z ustawień
       sekcji przez parametr renderu, żadnego CSS specyficznego dla karty tutaj. */

    /* Karuzela: wrapper 1:1 jak w snippets/resource-list.liquid dla layout_type: "carousel" */
    #shopify-section-{{ section.id }} .mmw-pc__carousel-wrap { width: 100%; }
    /* snippets/resource-list-carousel.liquid ustawia to samo (.resource-list__carousel
       .resource-list__slide { scroll-snap-align: start; }), nadpisując domyślne "center" z
       bazowego slideshow-slide (snippets/slideshow-styles.liquid). Deklarujemy to też u siebie
       — bez tego przeglądarka snapuje pierwszy slajd na ŚRODEK viewportu, nie na start gutteru,
       więc "spoczynek" karty nie licuje się z nagłówkiem nawet przy poprawnym --gutter-slide-width. */
    .mmw-pc__carousel-wrap .resource-list__slide { scroll-snap-align: start; }

    /* Kropki wyśrodkowane pod karuzelą (native .slideshow-controls__dots) — kolory przez
       zmienne komponentu (--color/--color-active/--color-hover), bez twardych selektorów */
    #shopify-section-{{ section.id }} slideshow-controls {
      margin-top: 8px;
      /* Natywnie kropki są barwione przez mix-blend-mode: difference (myślane pod kropki na
         zdjęciu/mediach) — u nas stoją na tle sekcji, więc wyłączamy to i barwimy wprost. */
      mix-blend-mode: normal;
      --color: rgba(95, 49, 47, 0.25);
      --color-active: var(--mmw-01, #5f312f);
      --color-hover: rgba(95, 49, 47, 0.4);
    }

    /* Karta końcowa „Zobacz więcej” — ten sam rozmiar slajdu co karty produktów + hover jak mmw-how-its-made */
    #shopify-section-{{ section.id }} .mmw-pc__end {
      position: relative; display: flex; width: 100%; aspect-ratio: {{ card_ratio }};
      border: 1px solid rgba(95,49,47,.25); border-radius: 16px; overflow: hidden;
      align-items: center; justify-content: center; text-align: center; padding: 32px;
      text-decoration: none; background: var(--mmw-04);
      transition: background-color .3s ease;
    }
    #shopify-section-{{ section.id }} .mmw-pc__end:hover { background: var(--mmw-03); }
    #shopify-section-{{ section.id }} .mmw-pc__end-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: .18; }
    #shopify-section-{{ section.id }} .mmw-pc__end-content { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; gap: 24px; }
    #shopify-section-{{ section.id }} .mmw-pc__end-heading { margin: 0; font-family: var(--mmw-font-display); font-weight: 400; font-size: 36px; line-height: 1.1; color: var(--mmw-01); }
    #shopify-section-{{ section.id }} .mmw-pc__end-btn {
      width: 44px; height: 44px; border-radius: 50%; background: var(--mmw-01); color: var(--mmw-04);
      display: grid; place-items: center;
    }
    #shopify-section-{{ section.id }} .mmw-pc__end-btn .icon-arrow,
    #shopify-section-{{ section.id }} .mmw-pc__end-btn svg { width: 22px; height: 22px; }

    .mmw-pc slideshow-slides {
  padding-inline-start: var(--util-page-margin-offset, var(--page-margin, 40px)) !important;
  padding-inline-end: var(--util-page-margin-offset, var(--page-margin, 40px)) !important;
  scroll-padding-inline-start: var(--util-page-margin-offset, var(--page-margin, 40px)) !important;
}
.mmw-pc .resource-list__slide,
.mmw-pc slideshow-slide {
  scroll-snap-align: start;
}

    @media (max-width: 989px) {
      #shopify-section-{{ section.id }} .mmw-pc { padding-block: 40px; gap: 36px; }
      #shopify-section-{{ section.id }} .mmw-pc__title { font-size: 36px; }
    }
    @media (max-width: 749px) {
      #shopify-section-{{ section.id }} .mmw-carousel-card__excerpt { -webkit-line-clamp: 2; }

      /* Mobile: jedna karta na ekran, wycentrowana, ze skrawkami sąsiadów po bokach.
         --mmw-pc-gutter-mobile zastępuje --util-page-margin-offset TYLKO na mobile —
         desktop (reguła wyżej) zostaje bez zmian. Szerokość karty nadal idzie przez
         --slide-width (ten sam mechanizm co peek-width na desktopie w
         resource-list-carousel.liquid), nie przez osobny system. */
      #shopify-section-{{ section.id }} .mmw-pc { --mmw-pc-gutter-mobile: 36px; }

      #shopify-section-{{ section.id }} .mmw-pc__head { padding-inline: var(--mmw-pc-gutter-mobile); }

       .mmw-pc slideshow-arrows {
    display: none;
  }

      .mmw-pc slideshow-slides {
        padding-inline-start: var(--mmw-pc-gutter-mobile) !important;
        padding-inline-end: var(--mmw-pc-gutter-mobile) !important;
        scroll-padding-inline-start: var(--mmw-pc-gutter-mobile) !important;
        scroll-padding-inline-end: var(--mmw-pc-gutter-mobile) !important;
      }

      #shopify-section-{{ section.id }} .mmw-pc__carousel-wrap .resource-list__slide {
        --slide-width: calc((100vw - 2 * var(--mmw-pc-gutter-mobile) + 12px) * 0.85);
      }

      /* scroll-snap-align: start (reguła wyżej) przy tej szerokości karty przykleja ją
         do lewego gutteru — prawy skrawek wychodzi duży, lewego brak. center centruje
         kartę w obrębie scroll-padding, dając skrawki po obu stronach. Tylko mobile —
         desktop zostaje na start (peek-width tam jest symetryczny z automatu, bo karty
         wypełniają cały wiersz). */
      .mmw-pc .resource-list__slide,
      .mmw-pc slideshow-slide {
        scroll-snap-align: center;
      }
    }
  {%- endstyle -%}

  {%- comment -%} Karty produktów + opcjonalna karta końcowa → tablica HTML (ten sam trik co list_items_array w sections/product-list.liquid). {%- endcomment -%}
  {%- capture cards_concat -%}
    {%- assign item_index = 0 -%}
    {%- for product in coll.products limit: count -%}
      {%- if item_index > 0 -%}<!--@mmw-pc/split-->{%- endif -%}
      {%- assign item_index = item_index | plus: 1 -%}
      {%- render 'mmw-carousel-card', product: product, section_id: section.id, card_ratio: card_ratio, desc_len: desc_len, sizes: card_sizes -%}
    {%- endfor -%}
    {%- if show_end_card -%}
      {%- if item_index > 0 -%}<!--@mmw-pc/split-->{%- endif -%}
      <a class="mmw-pc__end" href="{{ section.settings.end_card_link | default: coll.url }}">
        {%- if section.settings.end_card_image != blank -%}
          <img class="mmw-pc__end-img" src="{{ section.settings.end_card_image | image_url: width: 640 }}" width="640" height="980" alt="" loading="lazy">
        {%- endif -%}
        <div class="mmw-pc__end-content">
          <p class="mmw-pc__end-heading">{{ section.settings.end_card_heading | newline_to_br }}</p>
          <span class="mmw-pc__end-btn" aria-hidden="true">
            <span class="svg-wrapper icon-arrow">{{- 'icon-arrow.svg' | inline_asset_content -}}</span>
          </span>
        </div>
      </a>
    {%- endif -%}
  {%- endcapture -%}
  {%- assign cards_array = cards_concat | strip | split: '<!--@mmw-pc/split-->' -%}

  {%- comment -%}
    Od tego miejsca w dół — logika 1:1 skopiowana z snippets/resource-list.liquid (wrapper
    .resource-list.resource-list__carousel z tymi samymi zmiennymi CSS) i
    snippets/resource-list-carousel.liquid (gutter/peek-width, strzałki), rozszerzona TYLKO
    o parametr `controls` (kropki) w wywołaniu 'slideshow', którego resource-list-carousel.liquid
    nie udostępnia.
  {%- endcomment -%}
  {%- capture resource_list_style -%}
    --resource-list-column-gap-desktop: {{ columns_gap }}px;
    --column-count: {{ columns }};
    --column-count-mobile: 1;
    --mobile-card-size: {{ mobile_card_size }};
  {%- endcapture -%}

  {%- liquid
    assign carousel_ref = 'mmwPc-' | append: section.id
    assign show_arrows = false
    if section.settings.icons_style != 'none'
      assign show_arrows = true
    endif
    # Gutter 1:1 jak w snippets/resource-list-carousel.liquid: div ze zmiennymi wokół
    # <slideshow-component>, atrybut gutters="start end" na <slideshow-slides> (przez
    # slideshow_gutters) generuje ślepe guttery o szerokości --gutter-slide-width na
    # początku/końcu pasa — TO jest jedyny mechanizm wyrównania skrajnych kart, bez
    # żadnego własnego paddingu/scroll-paddingu z naszej strony.
    if section.settings.section_width == 'page-width'
      assign slideshow_gutters = 'start end'
      assign gutter_style = '--gutter-slide-width: var(--util-page-margin-offset, var(--page-margin, 40px)); --slide-width-max: 400px;'
    else
      assign slideshow_gutters = null
      assign gutter_style = '--gutter-slide-width: 0px; --slide-width-max: 400px;'
    endif
  -%}
  {%- capture carousel_slides -%}
    {%- for item in cards_array -%}
      {%- render 'slideshow-slide', index: forloop.index0, children: item, class: 'resource-list__slide' -%}
    {%- endfor -%}
  {%- endcapture -%}
  {%- capture carousel_controls -%}
    {%- render 'slideshow-controls', style: 'dots', item_count: cards_array.size, show_arrows: false, pagination_position: 'center' -%}
  {%- endcapture -%}

  <section class="mmw-pc section color-{{ section.settings.color_scheme }}">
    <div class="mmw-pc__head">
      {%- if section.settings.heading != blank -%}<h2 class="mmw-pc__title">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.description != blank -%}<p class="mmw-pc__desc">{{ section.settings.description }}</p>{%- endif -%}
    </div>

    <div class="resource-list resource-list__carousel mmw-pc__carousel-wrap" style="{{ resource_list_style }}">
      <div style="{{ gutter_style }}">
        {%- render 'slideshow',
          ref: carousel_ref,
          class: 'resource-list__carousel',
          slides: carousel_slides,
          show_arrows: show_arrows,
          icon_style: section.settings.icons_style,
          icon_shape: section.settings.icons_shape,
          auto_hide_controls: false,
          infinite: false,
          initial_slide: 0,
          slide_count: cards_array.size,
          slideshow_gutters: slideshow_gutters,
          controls: carousel_controls
        -%}
      </div>
    </div>
  </section>
{%- endif -%}
{% schema %}
{
  "name": "MMW Karuzela produktów",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Nagłówek", "default": "Poznaj nasze bestsellery" },
    { "type": "textarea", "id": "description", "label": "Opis", "default": "Smaki, aromaty i historie zamknięte w markach tworzonych w sercu Majątku Mała Wieś. Poznaj je wszystkie." },
    { "type": "collection", "id": "collection", "label": "Kolekcja produktów" },
    { "type": "range", "id": "products_count", "min": 2, "max": 16, "step": 1, "label": "Liczba kart", "default": 8 },
    { "type": "range", "id": "description_length", "min": 60, "max": 300, "step": 10, "unit": "zn.", "label": "Długość opisu karty", "default": 140 },
    {
      "type": "select", "id": "card_ratio", "label": "Proporcje karty", "default": "tall",
      "options": [
        { "value": "tall", "label": "Wysoka (jak w Figmie)" },
        { "value": "portrait", "label": "Portret (4:5)" },
        { "value": "square", "label": "Kwadrat (1:1)" }
      ]
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Schemat kolorów (strzałki, kropki, przycisk Dodaj)", "default": "scheme-1" },
    { "type": "paragraph", "content": "Badge karty ustawia się automatycznie: cena promocyjna produktu → rabat (np. „-10%”), tag „bestseller” → BESTSELLER, tag „nowość” → NOWOŚĆ. Opis karty: metapole custom.opis_karty, a bez niego — opis produktu (skrócony do długości powyżej). Przycisk „Dodaj” pokazuje się tylko, gdy w Ustawieniach motywu → Koszyk włączony jest Quick Add." },
    { "type": "header", "content": "Karuzela (jak w natywnych karuzelach produktów)" },
    { "type": "range", "id": "columns", "min": 2, "max": 5, "step": 1, "label": "Kart na widok (desktop)", "default": 3 },
    { "type": "range", "id": "columns_gap", "min": 0, "max": 60, "step": 2, "unit": "px", "label": "Odstęp między kartami", "default": 24 },
    {
      "type": "select", "id": "mobile_card_size", "label": "Rozmiar karty (mobile)", "default": "60cqw",
      "options": [
        { "value": "60cqw", "label": "Duża (ok. 1 karta na ekranie)" },
        { "value": "44cqw", "label": "Mniejsza (ok. 2 karty na ekranie)" }
      ]
    },
    {
      "type": "select", "id": "section_width", "label": "Szerokość sekcji", "default": "page-width",
      "options": [
        { "value": "page-width", "label": "Szerokość strony" },
        { "value": "full-width", "label": "Pełna szerokość" }
      ]
    },
    {
      "type": "select", "id": "icons_style", "label": "Styl strzałek", "default": "arrow",
      "options": [
        { "value": "arrow", "label": "Strzałka" },
        { "value": "chevron", "label": "Szewron" },
        { "value": "arrows_large", "label": "Strzałka (duża)" },
        { "value": "chevron_large", "label": "Szewron (duży)" },
        { "value": "none", "label": "Brak" }
      ]
    },
    {
      "type": "select", "id": "icons_shape", "label": "Tło strzałek", "default": "circle",
      "options": [
        { "value": "none", "label": "Brak" },
        { "value": "circle", "label": "Koło" },
        { "value": "square", "label": "Kwadrat" }
      ]
    },
    { "type": "header", "content": "Karta końcowa „Zobacz więcej”" },
    { "type": "checkbox", "id": "show_end_card", "label": "Pokaż kartę końcową", "default": true },
    { "type": "textarea", "id": "end_card_heading", "label": "Tekst karty końcowej", "default": "Zobacz więcej\nbestsellerów" },
    { "type": "url", "id": "end_card_link", "label": "Link karty końcowej" },
    { "type": "image_picker", "id": "end_card_image", "label": "Tło karty końcowej (opcjonalnie)" }
  ],
  "presets": [{ "name": "MMW Karuzela produktów" }]
}
{% endschema %}
