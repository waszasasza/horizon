{%- comment -%}
  mmw-stats — "Majątek w liczbach": nagłówek + rząd statystyk (liczba + opis,
  opcjonalna dekoracja obok liczby). Reużywalna na głównej i podstronach "o nas".

  Figma: plik STRONA-WWW, node 982:7897.
{%- endcomment -%}

<section class="mmw-stats section">
  <div class="mmw-stats__inner mmw-wrap">
    {%- if section.settings.heading != blank -%}
      <h2 class="mmw-stats__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="mmw-stats__row">
        {%- for block in section.blocks -%}
          {%- liquid
            assign decoration_asset = blank
            case block.settings.decoration
              when 'shape-1'
                assign decoration_asset = 'mmw-stat-doodle-1.svg'
              when 'shape-2'
                assign decoration_asset = 'mmw-stat-doodle-2.svg'
            endcase
          -%}
          <div class="mmw-stats__item" {{ block.shopify_attributes }}>
            <div class="mmw-stats__number-row">
              {%- if block.settings.number != blank -%}
                <p class="mmw-stats__number">{{ block.settings.number }}</p>
              {%- endif -%}
              {%- if decoration_asset != blank -%}
                <span class="mmw-stats__decoration mmw-stats__decoration--{{ block.settings.decoration }}" aria-hidden="true">
                  {{- decoration_asset | inline_asset_content -}}
                </span>
              {%- endif -%}
            </div>
            {%- if block.settings.description != blank -%}
              <p class="mmw-stats__desc">{{ block.settings.description }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .mmw-stats {
    padding-block: 60px;
    background: var(--mmw-04);
  }

  .mmw-stats__inner {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .mmw-stats__heading {
    margin: 0;
    width: 100%;
    font-family: var(--mmw-font-display);
    font-weight: 400;
    font-size: 60px;
    line-height: 1;
    color: var(--mmw-01);
  }

  .mmw-stats__row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 70px;
  }

  .mmw-stats__item {
    flex: 1 0 0;
    min-width: 0; /* bez tego długie liczby (np. "200K+") rozwalają równy podział kolumn */
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding-block: 20px;
    border-bottom: 1px solid rgba(95, 49, 47, 0.25);
  }

  .mmw-stats__number-row {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .mmw-stats__number {
    margin: 0;
    font-family: var(--mmw-font-display);
    font-weight: 400;
    font-size: 64px;
    line-height: 1.1;
    color: var(--mmw-01);
    white-space: nowrap;
  }

  .mmw-stats__decoration {
    flex: 0 0 auto;
    display: block;
    color: var(--mmw-01);
  }

  .mmw-stats__decoration svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .mmw-stats__decoration--shape-1 {
    width: 17px;
    height: 26px;
  }

  .mmw-stats__decoration--shape-2 {
    width: 22.58px;
    height: 22.58px;
  }

  .mmw-stats__desc {
    margin: 0;
    font-family: var(--mmw-font-text);
    font-weight: 400;
    font-size: 16px;
    line-height: 1.4;
    color: var(--mmw-01);
  }

  @media (max-width: 989px) {
    .mmw-stats__row {
      gap: 32px;
    }

    .mmw-stats__item {
      flex: 1 1 calc(50% - 16px);
    }
  }

  @media (max-width: 749px) {
    .mmw-stats__item {
      flex: 1 1 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "MMW Statystyki",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Nagłówek",
      "default": "Chcesz poznać nas lepiej? Oto Majątek w liczbach!"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Statystyka",
      "limit": 6,
      "settings": [
        { "type": "text", "id": "number", "label": "Liczba", "default": "100+" },
        {
          "type": "select",
          "id": "decoration",
          "label": "Dekoracja obok liczby",
          "options": [
            { "value": "none", "label": "Brak" },
            { "value": "shape-1", "label": "Kształt 1" },
            { "value": "shape-2", "label": "Kształt 2" }
          ],
          "default": "none"
        },
        { "type": "text", "id": "description", "label": "Opis", "default": "Opis statystyki" }
      ]
    }
  ],
  "presets": [
    {
      "name": "MMW Statystyki",
      "blocks": [
        {
          "type": "stat",
          "settings": {
            "number": "18",
            "decoration": "shape-1",
            "description": "Tyle nagród dostały nasze produkty na przestrzeni ostatnich 5 lat!"
          }
        },
        {
          "type": "stat",
          "settings": {
            "number": "200K+",
            "decoration": "none",
            "description": "Zrealizowanych zamówień dla Was. Czekamy na następne tyle!"
          }
        },
        {
          "type": "stat",
          "settings": {
            "number": "5000+",
            "decoration": "shape-2",
            "description": "5000 zrealizowanych eventów! To czyni nas doświadczonymi."
          }
        },
        {
          "type": "stat",
          "settings": {
            "number": "78",
            "decoration": "none",
            "description": "Tyle liczy nasz zespół, który na co dzień opiekuje się naszymi gośćmi!"
          }
        }
      ]
    }
  ]
}
{% endschema %}
